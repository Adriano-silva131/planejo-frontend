{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "ignorePatterns": ["src/shared/api/schema.d.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/forbid-dom-props": ["error", { "forbid": ["style"] }],
    "react/forbid-component-props": ["error", { "forbid": ["style"] }],
    "import/no-default-export": "error",
    "import/no-cycle": "error",
    "max-lines": ["error", { "max": 200, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["error", { "max": 80, "skipBlankLines": true, "skipComments": true }],
    "complexity": ["error", 10],
    "max-depth": ["error", 3],
    "max-params": ["error", 4],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/utils", "**/utils/**", "**/helpers", "**/helpers/**", "**/common", "**/common/**"],
            "message": "Dê ao módulo o nome do que ele faz."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@/features/**", "**/features/**"], "message": "shared não depende de features." },
              { "group": ["**/utils", "**/utils/**", "**/helpers", "**/helpers/**", "**/common", "**/common/**"], "message": "Dê ao módulo o nome do que ele faz." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@/features/**"], "message": "Uma feature não importa outra; mova o código comum para shared/." },
              { "group": ["**/utils", "**/utils/**", "**/helpers", "**/helpers/**", "**/common", "**/common/**"], "message": "Dê ao módulo o nome do que ele faz." }
            ]
          }
        ]
      }
    },
    {
      "files": ["*.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off"
      }
    }
  ]
}
